    {
      "parameters": {
        "jsCode": "const response = $json;\nconst trip = $('Normalize Trip Details').item.json;\n\nconst results = [];\nconst groups = [];\n\nif (Array.isArray(response.best_flights)) groups.push(...response.best_flights);\nif (Array.isArray(response.other_flights)) groups.push(...response.other_flights);\n\nfor (const item of groups) {\n  const segments = Array.isArray(item.flights) ? item.flights : [];\n  const first = segments[0] || {};\n  const last = segments[segments.length - 1] || {};\n\n  const airlines = [...new Set(segments.map(x => x.airline).filter(Boolean))];\n\n  results.push({\n    price: Number(item.price || 0),\n    total_duration_minutes: Number(item.total_duration || 0),\n    stops: Math.max(0, segments.length - 1),\n    airlines,\n    flight_number: first.flight_number || 'Not available',\n    departure_airport: first.departure_airport?.name || trip.origin,\n    departure_airport_code: first.departure_airport?.id || '',\n    departure_time: first.departure_airport?.time || '',\n    arrival_airport: last.arrival_airport?.name || trip.destination,\n    arrival_airport_code: last.arrival_airport?.id || '',\n    arrival_time: last.arrival_airport?.time || '',\n    carbon_emissions: item.carbon_emissions || null,\n    booking_token: item.booking_token || '',\n    departure_token: item.departure_token || ''\n  });\n}\n\nresults.sort((a,b) => a.price - b.price);\n\nconst cheapest = results[0] || null;\nconst expensive = results.length ? results[results.length - 1] : null;\n\nconst bestValue = [...results].sort((a,b) => {\n  const scoreA = (a.price * 0.55) + (a.total_duration_minutes * 0.25) + (a.stops * 180 * 0.20);\n  const scoreB = (b.price * 0.55) + (b.total_duration_minutes * 0.25) + (b.stops * 180 * 0.20);\n  return scoreA - scoreB;\n})[0] || null;\n\nconst prices = results.map(x => x.price).filter(x => x > 0);\n\nreturn [\n  {\n    json: {\n      flight_search_status: results.length ? 'Live flight results found' : 'No live flight results returned',\n      flights_found: results.length,\n      currency: trip.currency,\n      cheapest_flight: cheapest,\n      best_value_flight: bestValue,\n      expensive_flight: expensive,\n      lowest_price: prices.length ? Math.min(...prices) : null,\n      highest_price: prices.length ? Math.max(...prices) : null,\n      price_insights: response.price_insights || null,\n      flight_options: results.slice(0, 15),\n      raw_flight_metadata: {\n        search_information: response.search_information || null,\n        search_parameters: response.search_parameters || null\n      }\n    }\n  }\n];"
      },
