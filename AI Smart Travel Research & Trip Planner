      "parameters": {
        "jsCode": "const data = $json;\n\nconst totalTravelers = Math.max(1, Number(data['Total Travelers'] || 1));\nconst adults = Math.max(0, Number(data['Adults'] || totalTravelers));\nconst children = Math.max(0, Number(data['Children'] || 0));\nconst budget = Number(data['Total Trip Budget'] || 0);\n\nconst departure = data['Departure Date'];\nconst returnDate = data['Return Date'];\n\nlet nights = 0;\nlet days = 1;\n\nif (departure && returnDate) {\n  const start = new Date(departure + 'T00:00:00');\n  const end = new Date(returnDate + 'T00:00:00');\n  const diff = end.getTime() - start.getTime();\n  if (!isNaN(diff) && diff >= 0) {\n    nights = Math.round(diff / 86400000);\n    days = nights + 1;\n  }\n}\n\nif (nights === 0 && data['Trip Type'] === 'One Way') {\n  nights = 0;\n  days = 1;\n}\n\nconst currency = String(data['Currency'] || 'USD').trim().toUpperCase();\nconst cabinMap = {\n  'Economy': '1',\n  'Premium Economy': '2',\n  'Business': '3',\n  'First Class': '4'\n};\n\nconst cabin = cabinMap[data['Cabin Class']] || '1';\n\nreturn [\n  {\n    json: {\n      full_name: data['Full Name'] || '',\n      email: data['Email'] || '',\n      origin: data['From'] || '',\n      destination: data['Destination'] || '',\n      trip_type: data['Trip Type'] || 'Round Trip',\n      departure_date: departure || '',\n      return_date: returnDate || '',\n      total_travelers: totalTravelers,\n      adults,\n      children,\n      budget,\n      currency,\n      cabin_class: data['Cabin Class'] || 'Economy',\n      cabin_code: cabin,\n      hotel_preference: data['Hotel Preference'] || 'Best Value',\n      trip_style: data['Trip Style'] || 'Balanced',\n      interests: data['Interests'] || '',\n      special_requirements: data['Special Requirements'] || '',\n      nights,\n      days,\n      rooms_needed: Math.max(1, Math.ceil(totalTravelers / 2)),\n      budget_per_person: budget > 0 ? Math.round((budget / totalTravelers) * 100) / 100 : 0,\n      original_form_data: data\n    }\n  }\n];"
      },
