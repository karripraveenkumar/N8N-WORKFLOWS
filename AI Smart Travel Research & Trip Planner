    {
      "parameters": {
        "jsCode": "const response = $json;\nconst trip = $('Normalize Trip Details').item.json;\n\nconst properties = [];\n\nconst sources = [];\nif (Array.isArray(response.properties)) sources.push(...response.properties);\nif (Array.isArray(response.ads)) sources.push(...response.ads);\nif (Array.isArray(response.non_matching_properties)) sources.push(...response.non_matching_properties);\n\nfor (const hotel of sources) {\n  const price = Number(\n    hotel.extracted_price ||\n    hotel.rate_per_night?.extracted_lowest ||\n    hotel.total_rate?.extracted_lowest ||\n    0\n  );\n\n  if (!hotel.name) continue;\n\n  properties.push({\n    name: hotel.name,\n    source: hotel.source || 'Google Hotels',\n    rating: Number(hotel.overall_rating || 0),\n    reviews: Number(hotel.reviews || 0),\n    hotel_class: hotel.hotel_class || null,\n    price_per_night: price,\n    displayed_price: hotel.price || hotel.rate_per_night?.lowest || 'Not available',\n    total_rate: hotel.total_rate?.lowest || 'Not available',\n    amenities: Array.isArray(hotel.amenities) ? hotel.amenities.slice(0, 15) : [],\n    free_cancellation: hotel.free_cancellation ?? null,\n    link: hotel.link || hotel.serpapi_property_details_link || '',\n    property_token: hotel.property_token || '',\n    description: hotel.description || ''\n  });\n}\n\nconst unique = [];\nconst seen = new Set();\n\nfor (const hotel of properties) {\n  const key = hotel.name.toLowerCase();\n  if (!seen.has(key)) {\n    seen.add(key);\n    unique.push(hotel);\n  }\n}\n\nconst priced = unique.filter(x => x.price_per_night > 0).sort((a,b) => a.price_per_night - b.price_per_night);\n\nconst cheapest = priced[0] || unique[0] || null;\nconst expensive = priced.length ? priced[priced.length - 1] : null;\n\nconst bestValue = [...unique].sort((a,b) => {\n  const scoreA = (a.price_per_night || 999999) * 0.45 - (a.rating || 0) * 20 - Math.min(a.reviews || 0, 5000) * 0.002;\n  const scoreB = (b.price_per_night || 999999) * 0.45 - (b.rating || 0) * 20 - Math.min(b.reviews || 0, 5000) * 0.002;\n  return scoreA - scoreB;\n})[0] || null;\n\nfunction totalFor(hotel) {\n  if (!hotel || !hotel.price_per_night || !trip.nights) return null;\n  return Math.round(hotel.price_per_night * trip.nights * trip.rooms_needed * 100) / 100;\n}\n\nconst hotelOptions = priced.slice(0, 15).map(h => ({\n  ...h,\n  estimated_total_stay_for_group: totalFor(h),\n  estimated_total_per_person: totalFor(h) ? Math.round((totalFor(h) / trip.total_travelers) * 100) / 100 : null\n}));\n\nreturn [\n  {\n    json: {\n      hotel_search_status: unique.length ? 'Live hotel results found' : 'No live hotel results returned',\n      hotels_found: unique.length,\n      cheapest_hotel: cheapest ? { ...cheapest, estimated_total_stay_for_group: totalFor(cheapest) } : null,\n      best_value_hotel: bestValue ? { ...bestValue, estimated_total_stay_for_group: totalFor(bestValue) } : null,\n      premium_hotel: expensive ? { ...expensive, estimated_total_stay_for_group: totalFor(expensive) } : null,\n      hotel_options: hotelOptions,\n      rooms_needed: trip.rooms_needed,\n      nights: trip.nights,\n      hotel_search_metadata: {\n        search_information: response.search_information || null,\n        search_parameters: response.search_parameters || null\n      }\n    }\n  }\n];"
      },
