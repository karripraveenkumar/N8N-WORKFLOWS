      "id": "a3b654af-2df2-470d-8f4f-5bb810baf157",
      "name": "LinkedIn Jobs Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        896,
        64
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $json;\n\nlet html = '';\n\nif (typeof input.data === 'string') {\n  html = input.data;\n} else if (typeof input.body === 'string') {\n  html = input.body;\n} else if (typeof input.response === 'string') {\n  html = input.response;\n} else {\n  html = '';\n}\n\nfunction decode(value) {\n  return String(value || '')\n    .replace(/&amp;/gi, '&')\n    .replace(/&quot;/gi, '\"')\n    .replace(/&#39;/gi, \"'\")\n    .replace(/&apos;/gi, \"'\")\n    .replace(/&lt;/gi, '<')\n    .replace(/&gt;/gi, '>')\n    .replace(/&#x27;/gi, \"'\")\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\nfunction stripTags(value) {\n  return decode(String(value || '').replace(/<[^>]*>/g, ' '));\n}\n\nconst jobs = [];\n\nif (html) {\n  const cardRegex = /<li[^>]*>([\\s\\S]*?)<\\/li>/gi;\n  let match;\n\n  while ((match = cardRegex.exec(html)) !== null) {\n    const card = match[1];\n\n    const titleMatch = card.match(/class=[\"'][^\"']*base-search-card__title[^\"']*[\"'][^>]*>([\\s\\S]*?)<\\/h3>/i);\n    const companyMatch = card.match(/class=[\"'][^\"']*base-search-card__subtitle[^\"']*[\"'][^>]*>([\\s\\S]*?)<\\/h4>/i);\n    const locationMatch = card.match(/class=[\"'][^\"']*job-search-card__location[^\"']*[\"'][^>]*>([\\s\\S]*?)<\\/span>/i);\n    const urlMatch = card.match(/href=[\"']([^\"']*\\/jobs\\/view\\/[^\"']+)[\"']/i);\n\n    if (!titleMatch) continue;\n\n    const title = stripTags(titleMatch[1]);\n    const company = companyMatch ? stripTags(companyMatch[1]) : 'Not available';\n    const location = locationMatch ? stripTags(locationMatch[1]) : 'Not available';\n    const url = urlMatch ? decode(urlMatch[1]) : 'Not available';\n\n    if (!title) continue;\n\n    const exists = jobs.some(job =>\n      job.job_title.toLowerCase() === title.toLowerCase() &&\n      job.company.toLowerCase() === company.toLowerCase()\n    );\n\n    if (!exists) {\n      jobs.push({\n        job_title: title,\n        company: company,\n        location: location,\n        job_url: url\n      });\n    }\n\n    if (jobs.length >= 20) break;\n  }\n}\n\nreturn [\n  {\n    json: {\n      linkedin_jobs: jobs,\n      linkedin_jobs_found: jobs.length,\n      linkedin_search_status: jobs.length > 0 ? 'Jobs found' : 'No jobs found or LinkedIn did not return public job data'\n    }\n  }\n];"
      },
      "id": "dd2d9d13-e8d9-4ae2-a001-fce2b714c160",
