    {
      "parameters": {
        "promptType": "define",
        "text": "=Candidate Name:\n{{ $json.candidate_name }}\n\nCandidate Email:\n{{ $json.candidate_email }}\n\nResume Text:\n{{ $json.resume_text }}\n\nAnalyze this resume and determine the most suitable job roles for this candidate.\n\nCreate a LinkedIn search query using 3 to 5 highly relevant job titles based strictly on the candidate's resume.\n\nAlso identify the candidate's experience level, location if explicitly mentioned, and strongest skills.\n\nReturn only valid JSON.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an expert Resume Analyst and Job Search Strategist.\n\nAnalyze the candidate resume strictly from the information provided.\n\nIdentify the candidate's:\n- Experience level\n- Location if explicitly mentioned\n- Strongest technical skills\n- Strongest professional skills\n- Main career direction\n- Best-fit job roles\n\nThen create ONE LinkedIn job search query containing 3 to 5 relevant job titles separated by OR.\n\nExample:\nPython Developer OR Backend Developer OR Junior Software Engineer OR Full Stack Developer\n\nRules:\n- Never invent skills.\n- Never invent experience.\n- Never invent education.\n- Never invent certifications.\n- Never invent a location.\n- Do not recommend senior roles if the candidate is entry-level.\n- Only recommend roles supported by the resume.\n- If location is not available, use an empty string.\n- Return ONLY valid JSON."
        }
      },
