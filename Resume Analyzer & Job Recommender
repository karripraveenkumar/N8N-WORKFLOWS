        "message": "=<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Resume Analysis Report</title>\n</head>\n<body style=\"margin:0;padding:0;background:#f4f6f8;font-family:Arial,Helvetica,sans-serif;\">\n\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f4f6f8;padding:25px 0;\">\n<tr>\n<td align=\"center\">\n\n<table width=\"680\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#ffffff;border-radius:10px;overflow:hidden;\">\n\n<tr>\n<td style=\"background:#1f2937;padding:25px;color:#ffffff;\">\n<h1 style=\"margin:0;font-size:23px;\">Resume Analysis Report</h1>\n<p style=\"margin:8px 0 0;font-size:14px;\">Personalized Job Recommendations</p>\n</td>\n</tr>\n\n<tr>\n<td style=\"padding:25px;color:#333333;font-size:14px;line-height:1.6;\">\n\n<p>Hi <strong>{{ $json.output.candidate_name || $('On form submission').item.json.Name }}</strong>,</p>\n\n<p>\nYour resume has been analyzed based on your skills, education, experience, projects and career profile. Available LinkedIn job listings were also compared with your profile.\n</p>\n\n<h2 style=\"font-size:19px;color:#111827;\">Profile Summary</h2>\n<p>{{ $json.output.profile_summary }}</p>\n\n<h2 style=\"font-size:19px;color:#111827;\">Your Strongest Skills</h2>\n<ul>\n{{ ($json.output.strengths || []).map(skill => '<li>' + skill + '</li>').join('') }}\n</ul>\n\n<h2 style=\"font-size:19px;color:#111827;\">Weaknesses / Skill Gaps</h2>\n<ul>\n{{ ($json.output.weaknesses || []).map(skill => '<li>' + skill + '</li>').join('') }}\n</ul>\n\n<h2 style=\"font-size:19px;color:#111827;\">Best-Fit Job Roles</h2>\n\n{{ ($json.output.best_fit_roles || []).map(role => '<div style=\"border:1px solid #e5e7eb;border-radius:8px;padding:16px;margin:12px 0;background:#fafafa;\"><div style=\"font-size:16px;font-weight:bold;\">' + role.role + '</div><div style=\"margin-top:7px;\"><strong>Suitability:</strong> ' + role.match_percentage + '%</div><div style=\"margin-top:7px;\"><strong>Why you fit:</strong> ' + role.why + '</div><div style=\"margin-top:7px;\"><strong>Matching skills:</strong> ' + (role.matching_skills || []).join(', ') + '</div><div style=\"margin-top:7px;\"><strong>Missing skills:</strong> ' + (role.missing_skills || []).join(', ') + '</div></div>').join('') }}\n\n<h2 style=\"font-size:19px;color:#111827;\">Recommended LinkedIn Jobs</h2>\n\n{{ ($json.output.linkedin_job_recommendations || []).length > 0 ? ($json.output.linkedin_job_recommendations || []).map(job => '<div style=\"border:1px solid #dbe3ea;border-radius:9px;padding:17px;margin:14px 0;\"><div style=\"font-size:17px;font-weight:bold;\">' + job.job_title + '</div><div style=\"margin-top:5px;font-size:14px;\">' + job.company + ' · ' + job.location + '</div><div style=\"margin-top:9px;\"><strong>Match:</strong> ' + job.match_percentage + '% · <strong>' + job.match_level + '</strong></div><div style=\"margin-top:7px;\"><strong>Matching Skills:</strong> ' + (job.matching_skills || []).join(', ') + '</div><div style=\"margin-top:7px;\"><strong>Missing Skills:</strong> ' + (job.missing_skills || []).join(', ') + '</div><div style=\"margin-top:7px;\"><strong>Why it matches:</strong> ' + job.why_it_matches + '</div><div style=\"margin-top:15px;\"><a href=\"' + job.job_url + '\" style=\"display:inline-block;background:#0a66c2;color:#ffffff;text-decoration:none;padding:10px 16px;border-radius:6px;font-weight:bold;\">View Job on LinkedIn</a></div></div>').join('') : '<div style=\"background:#fff7ed;border:1px solid #fed7aa;border-radius:8px;padding:15px;\">No strong matching LinkedIn jobs were found in the available search results.</div>' }}\n\n<h2 style=\"font-size:19px;color:#111827;\">Skills You Should Improve</h2>\n<ul>\n{{ ($json.output.skills_to_improve || []).map(skill => '<li>' + skill + '</li>').join('') }}\n</ul>\n\n<h2 style=\"font-size:19px;color:#111827;\">Final Recommendation</h2>\n<div style=\"background:#f3f4f6;border-radius:8px;padding:15px;\">\n{{ $json.output.final_recommendation }}\n</div>\n\n<p style=\"margin-top:30px;\">Best regards,<br><strong>AI Resume Analyzer</strong></p>\n\n</td>\n</tr>\n\n<tr>\n<td style=\"background:#f9fafb;padding:15px;text-align:center;color:#6b7280;font-size:11px;\">\nThis is an automated resume analysis report.\n</td>\n</tr>\n\n</table>\n\n</td>\n</tr>\n</table>\n\n</body>\n</html>",
        "options": {}
